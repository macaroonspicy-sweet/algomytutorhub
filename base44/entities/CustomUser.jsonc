{
  "name": "CustomUser",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "username": {
      "type": "string",
      "description": "Username for login (alternative to email)"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of uploaded profile photo"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number"
    },
    "telegram_account": {
      "type": "string",
      "description": "Telegram username or chat ID"
    },
    "telegram_bot_token": {
      "type": "string",
      "description": "Telegram Bot Token used by this user to send QC results to tutors (from @BotFather)"
    },
    "email": {
      "type": "string",
      "description": "Email address (used for login)"
    },
    "role": {
      "type": "string",
      "enum": [
        "Head of Retention",
        "Head of Tutor",
        "QC Team",
        "Feedback Team",
        "Team Leader",
        "Tutor"
      ],
      "description": "User role"
    },
    "taught_courses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Courses taught (only for Tutor and Team Leader roles)"
    },
    "link_bo": {
      "type": "string",
      "description": "Link BO"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "session_token": {
      "type": "string",
      "description": "Random session token issued at login and validated by backend functions"
    },
    "rbac": {
      "type": "object",
      "description": "RBAC permissions JSON",
      "properties": {
        "dashboard": {
          "type": "boolean"
        },
        "admin_crud": {
          "type": "boolean"
        },
        "student_feedback": {
          "type": "boolean"
        },
        "student_feedback_delete": {
          "type": "boolean"
        },
        "student_performance": {
          "type": "boolean"
        },
        "student_performance_delete": {
          "type": "boolean"
        },
        "qc_records": {
          "type": "boolean"
        },
        "qc_records_delete": {
          "type": "boolean"
        },
        "qc_monthly": {
          "type": "boolean"
        },
        "qc_monthly_delete": {
          "type": "boolean"
        },
        "my_qc": {
          "type": "boolean"
        },
        "category_courses": {
          "type": "boolean"
        },
        "category_qc": {
          "type": "boolean"
        },
        "category_module": {
          "type": "boolean"
        },
        "pdf_settings": {
          "type": "boolean"
        },
        "weekly_feedback": {
          "type": "boolean"
        },
        "weekly_feedback_delete": {
          "type": "boolean"
        },
        "task_management": {
          "type": "boolean"
        },
        "my_tasks": {
          "type": "boolean"
        },
        "my_weekly_feedback": {
          "type": "boolean"
        },
        "qc_submissions": {
          "type": "boolean"
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name",
    "email",
    "role"
  ]
}